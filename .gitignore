# ==========================================================
# .gitignore do projeto Trevo Team
# Fica na RAIZ do repositório e vale para as duas pastas:
#   front-end/  -> site (React + Vite)
#   back-end/   -> API (Node + Express + SQLite)
# Arquivos e pastas listados aqui NÃO vão para o GitHub.
# ==========================================================

# ---------- Dependências (o npm install recria) ----------
# Sem barra no começo: vale para front-end/, back-end/ e qualquer outra pasta
node_modules/

# ---------- Build do front (a Vercel gera sozinha) ----------
front-end/dist/
front-end/dist-ssr/

# ---------- Configurações com senhas e chaves ----------
# Os modelos .env.example CONTINUAM indo para o GitHub.
.env
.env.*
!.env.example
*.local

# ---------- Dados do back-end (ficam só no computador / no Volume da Railway) ----------
# Banco de dados e imagens enviadas pelo painel
back-end/data/
back-end/uploads/
*.db
*.db-shm
*.db-wal

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Editores e sistema ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Vercel ----------
.vercel/

# ---------- Drive ----------
.tmp.*